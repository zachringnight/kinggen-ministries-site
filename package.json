{
  "name": "kinggen-ministries-site",
  "version": "1.0.0",
  "description": "KingGen Ministries - Free Gospel-Centered Clinical Pastoral Counseling for Women",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean:build-artifacts": "node scripts/clean-build-artifacts.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "npm run -s clean:build-artifacts && next typegen && tsc --noEmit --incremental false",
    "verify:routes": "npm run -s clean:build-artifacts && npm run -s build && node scripts/verify-routes.mjs",
    "verify:deploy-context": "node scripts/verify-deploy-context.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "optimize-brand-images": "node scripts/optimize-brand-images.mjs",
    "generate-resources": "node scripts/generate-resource-pdfs.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.1",
    "framer-motion": "^12.26.2",
    "next": "^16.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.0.3",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vercel": "53.2.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
