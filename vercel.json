{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "autoAlias": false
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kinggen-ministries-site.vercel.app"
        }
      ],
      "destination": "https://kinggenministries.org/:path*",
      "permanent": true
    }
  ]
}
